# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string. Locally, `npm run db:local` prints one for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/coffee_cinnamon
# Set to true for hosted databases that require SSL (Render external connections).
DATABASE_SSL=false

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Enables demo accounts in the role switcher and the staff "reset demo" endpoint.
DEMO_MODE=true

PORT=5000
TZ=Asia/Kolkata
